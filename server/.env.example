# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Option 1: MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/library-management?retryWrites=true&w=majority
# Option 2: Local MongoDB
MONGODB_URI=mongodb://localhost:27017/library-management
# Option 3: Leave empty to auto-use in-memory MongoDB (great for evaluation)
# MONGODB_URI=

# Loan Configuration
DEFAULT_LOAN_DAYS=14
FINE_PER_DAY=5

# AI Feature (Optional - leave empty to use offline smart search)
# Google Gemini API Key
GEMINI_API_KEY=
